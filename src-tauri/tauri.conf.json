{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Parsec Clone",
  "version": "../package.json",
  "identifier": "local.parsecclone",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "title": "Parsec Clone", "width": 1280, "height": 800,
      "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --lang=en-US --auto-select-desktop-capture-source=\"Screen 1\""
    }],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
